# ===== DATABASE =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=boilerplate
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here
DB_SCHEMA=public

# ===== JWT =====
# Generate: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_base64_here

# 15 phút = 900000ms
ACCESS_TOKEN_LIFETIME=900000
# 7 ngày = 604800000ms
REFRESH_TOKEN_LIFETIME=604800000

# ===== MAIL (SMTP) =====
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here

# ===== REDIS =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=1

# ===== CLOUDINARY (File Upload) =====
# Dang ky tai https://cloudinary.com/console
# Lay tu Dashboard -> Account Details
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ===== GOOGLE OAUTH2 =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== MOBILE OAUTH2 =====
# Danh sách scheme cho phép redirect về app (cách nhau bằng dấu phẩy)
# findjob:// cho production build, exp:// cho Expo Go development
APP_OAUTH2_ALLOWED_MOBILE_SCHEMES=findjob://,exp://
